# SignalMap — Environment Variables
# Copy this to .env.local and fill in real values.
# NEVER commit .env.local to git.

# Required — get from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Required for live job data — free tier (200 req/mo) at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=

# Required — your Vercel deployment URL (or http://localhost:3000 for local dev)
NEXT_PUBLIC_APP_URL=
